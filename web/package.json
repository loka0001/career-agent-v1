{
  "name": "commerce-ai-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && node scripts/check-logical-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:journeys": "node scripts/verify-core-journeys.mjs",
    "verify:catalog": "node scripts/verify-catalog.mjs",
    "verify:calendar": "node scripts/verify-calendar.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:public": "node scripts/generate-public-assets.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "framer-motion": "^12.42.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.0",
    "jsdom": "29.1.1",
    "playwright-core": "^1.62.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  }
}
