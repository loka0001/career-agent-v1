# Environment: development, test, staging, or production.
APP_ENV=development
# Demo adapters and demo seed are allowed only outside production.
DEMO_MODE=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
DATABASE_URL=sqlite:///./data/commerce.db
VERIFY_POSTGRES_URL=
EXPECTED_MIGRATION_HEAD=20260902_0030
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=300
UPLOAD_DIRECTORY=data/uploads
CHROMA_DIRECTORY=data/chroma
SEARCH_PROVIDER=sql
SERVERLESS_MODE=false
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Used only when DEMO_MODE=true.
DEMO_MERCHANT_EMAIL=
DEMO_MERCHANT_PASSWORD_HASH=
DEMO_STORE_ID=demo-store

AI_PROVIDER=openai
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=30
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_OPEN_SECONDS=60
AI_INPUT_COST_PER_MILLION_USD=0.40
AI_OUTPUT_COST_PER_MILLION_USD=1.60

IMAGE_STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_TIMEOUT_SECONDS=30
MALWARE_SCANNER=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
MALWARE_SCAN_TIMEOUT_SECONDS=10

ENABLE_FAKE_PUBLISHING=false
ENABLE_REAL_PUBLISHING=false
META_GRAPH_API_BASE=https://graph.facebook.com
META_GRAPH_API_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
META_WHATSAPP_SOLUTION_ID=
META_OAUTH_REDIRECT_URI=http://localhost:8000/meta/oauth/callback
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
META_REQUEST_TIMEOUT_SECONDS=20
META_POLL_INTERVAL_SECONDS=2
META_POLL_TIMEOUT_SECONDS=60
SHOPIFY_APP_API_KEY=
SHOPIFY_APP_API_SECRET=
SHOPIFY_OAUTH_REDIRECT_URI=http://localhost:8000/shopify/oauth/callback
SHOPIFY_OAUTH_SCOPES=read_products,read_orders,write_webhooks
SHOPIFY_API_VERSION=2026-07
COMMERCE_REQUEST_TIMEOUT_SECONDS=30
RUN_META_SMOKE_TESTS=false
RUN_LIVE_AI_EVALS=false

# Current launch access policy. When enabled, the server grants the internal Growth
# entitlement without a trial expiry and refuses SaaS Checkout/portal creation.
FREE_ACCESS_MODE=true

# Dormant SaaS subscription billing. Set FREE_ACCESS_MODE=false before enabling Stripe.
BILLING_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_REQUEST_TIMEOUT_SECONDS=30

# Merchant order collection is independent of SaaS access. COD is available without cards.
PAYMENT_PROVIDER=cod
STRIPE_PAYMENT_WEBHOOK_SECRET=

# Transactional email. Supported production value: resend.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=

# Protect internal scheduler and release endpoints with independent secrets.
CRON_SECRET=
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY_VERSION=1
# Secret JSON object used only during key rotation, e.g. {"1":"previous-32+-char-key"}
INTEGRATION_ENCRYPTION_PREVIOUS_KEYS=

# The web process never runs jobs. Deploy scripts.worker as a separate service and set this
# to true only in that persistent worker runtime.
ENABLE_BACKGROUND_WORKER=false
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=300
WORKER_HEALTH_PORT=8081
# Comma-separated emails allowed to access the protected operator console.
OPERATOR_EMAILS=

MAX_IMAGE_BYTES=10485760
MAX_CHANNEL_MEDIA_BYTES=16777216
MAX_CUSTOMER_MESSAGE_LENGTH=2000
RETRIEVAL_MIN_SCORE=0.05
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
SENTRY_DSN=
RELEASE_SHA=

# Operator/CI-only deployment control. Keep values in GitHub/Vercel secrets or local
# ignored env files, never in this committed template.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
